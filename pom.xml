<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.cybergarage.upnp</groupId>
  <packaging>pom</packaging>
  <artifactId>upnp</artifactId>
  <version>2.2.0</version>

  <name>cybergarage-upnp</name>
  <description>UPnP tools, libraries and applications for Java platforms</description>
  <url>http://www.cybergarage.org/</url>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.deploy.skip>true</maven.deploy.skip>
    <sonar.organization>cybergarage</sonar.organization>
  </properties>

  <organization>
    <name>CyberGarage</name>
    <url>http://www.cybergarage.org/</url>
  </organization>

  <licenses>
    <license>
      <name>BSD</name>
      <url>https://github.com/cybergarage/cybergarage-upnp/blob/master/LICENSE.txt</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/cybergarage/cybergarage-upnp.git</connection>
    <developerConnection>scm:git:https://github.com/cybergarage/cybergarage-upnp.git</developerConnection>
    <url>https://github.com/cybergarage/cybergarage-upnp/</url>
  </scm>

  <developers>
    <developer>
      <id>skonno</id>
      <email>skonno@cybergarage.org</email>
      <name>Satoshi Konno</name>
      <url>http://www.cybergarage.org/</url>
      <roles>
        <role>admin</role>
      </roles>
      <organization>CyberGarage</organization>
      <organizationUrl>http://www.cybergarage.org/</organizationUrl>
      <timezone>UTC/GMT +9</timezone>
    </developer>
    <developer>
      <id>kismet-sl</id>
      <email>kismet-sl@users.sourceforge.net</email>
      <name>Stefano Lenzi</name>
      <roles>
        <role>mantainer</role>
        <role>developer</role>
      </roles>
      <timezone>CEST/CET</timezone>
    </developer>
  </developers>

  <contributors />

  <modules>
    <module>core</module>
    <module>std</module>
    <module>tools/control-point</module>
    <module>tools/igd-tool</module>
    <module>tools/upnpdump</module>
    <module>examples/tv</module>
    <module>examples/light</module>
    <module>examples/clock</module>
    <module>examples/washer</module>
    <module>examples/air-conditioner</module>
    <module>examples/remote-controller</module>
    <module>examples/media-server</module>
    <module>jacoco-aggregate</module>
  </modules>

    <build>
      <pluginManagement>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.15</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </pluginManagement>
    </build>

  <profiles>
    <!--
      Release to Maven Central (Sonatype Central Portal):
        mvn -Prelease -pl .,core,std clean deploy
      Requires a <server><id>central</id> entry with a Central Portal user token
      in ~/.m2/settings.xml and a GPG key for signing.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.10.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <excludeArtifacts>
                <excludeArtifact>upnp-control-point</excludeArtifact>
                <excludeArtifact>upnp-internet-gateway</excludeArtifact>
                <excludeArtifact>upnpdump</excludeArtifact>
                <excludeArtifact>tv</excludeArtifact>
                <excludeArtifact>light</excludeArtifact>
                <excludeArtifact>clock</excludeArtifact>
                <excludeArtifact>washer</excludeArtifact>
                <excludeArtifact>air-conditioner</excludeArtifact>
                <excludeArtifact>remote-controller</excludeArtifact>
                <excludeArtifact>media-server</excludeArtifact>
                <excludeArtifact>jacoco-aggregate</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
